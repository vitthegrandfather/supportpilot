# SupportPilot — fictional local/Docker configuration.
# Copy to a private env file you control. Do not commit real secrets.
# This repository never ships a .env file.

# FastAPI (production artifact)
SUPPORTPILOT_ENV=development
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql+asyncpg://supportpilot:supportpilot@localhost:5432/supportpilot
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
EMBEDDING_PROVIDER=sandbox
GENERATION_PROVIDER=sandbox
ACCESS_TOKEN_EXPIRE_MINUTES=480
SUPPORTPILOT_DEMO_AUTO_LOGIN=true

# Fictional demo operators (not real people)
DEMO_ADMIN_EMAIL=admin@heliodesk.example
DEMO_ADMIN_PASSWORD=DemoAdmin!2026
DEMO_OPERATOR_EMAIL=operator@heliodesk.example
DEMO_OPERATOR_PASSWORD=DemoOperator!2026

# Optional hosted adapters — leave empty. Preview and tests must not call paid models.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4.1-mini
